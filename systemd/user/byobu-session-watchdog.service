[Unit]
Description=Diagnose and restore Byobu when tmux sessions disappear
Documentation=file:%h/byobu-session-state/README.md

[Service]
Type=oneshot
ExecStart=%h/.local/bin/byobu-session-state watchdog --restart-codex autosave
Environment=BYOBU_SESSION_AUTO_RESTART_PROCESSES=0
Environment=BYOBU_SESSION_AUTO_RESTART_CODEX=1
