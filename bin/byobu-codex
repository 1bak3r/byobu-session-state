#!/usr/bin/env bash
set -euo pipefail

version="0.1.0"
snapshot_name="${BYOBU_SESSION_AUTOSAVE_NAME:-autosave}"
default_session="${BYOBU_CODEX_SESSION:-byobu}"

usage() {
  cat >&2 <<'EOF'
Usage:
  byobu-codex add [--name NAME] [--session SESSION] [--cd DIR] [--] [CODEX_ARGS...]
  byobu-codex new [--name NAME] [--session SESSION] [--cd DIR] [--] [CODEX_ARGS...]
  byobu-codex resume [--name NAME] [--session SESSION] [--cd DIR] SESSION_ID [CODEX_ARGS...]
  byobu-codex adopt [--session SESSION] [--dry-run]
  byobu-codex list
  byobu-codex save
  byobu-codex restore
  byobu-codex attach
  byobu-codex --version

Examples:
  byobu-codex add --name "Lab Notebook" --cd ~/projects/lab-notebook-agent
  byobu-codex add --name "New Goal" -- "work on the next goal"
  byobu-codex resume --name "Illustrator" 019f1075-142d-7ff1-b822-a1a07395d955
  byobu-codex adopt --dry-run

Notes:
  - New tabs are tagged with tmux window metadata so byobu-session-state can
    restore them as `codex resume SESSION_ID`.
  - If Codex exits with a nonzero status and a session id is known, this wrapper
    restarts it with `codex resume`.
  - If Codex exits without being restarted, the tab closes. Set
    BYOBU_CODEX_KEEP_SHELL_ON_EXIT=1 to leave a shell open instead.
EOF
}

fail() {
  printf '%s\n' "$*" >&2
  exit 1
}

fail_usage() {
  printf '%s\n\n' "$*" >&2
  usage
  exit 2
}

truthy() {
  case "${1:-}" in
    1|true|TRUE|yes|YES|y|Y|on|ON)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

ensure_tmux() {
  command -v tmux >/dev/null 2>&1 || fail "tmux is required."
}

is_uuid_like() {
  case "${1:-}" in
    ????????-????-????-????-????????????)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

now_ms() {
  local value
  value=$(date +%s%3N 2>/dev/null || true)
  case "$value" in
    *N*|'')
      printf '%s000\n' "$(date +%s)"
      ;;
    *)
      printf '%s\n' "$value"
      ;;
  esac
}

shell_join() {
  local out="" arg
  for arg in "$@"; do
    if [ -z "$out" ]; then
      printf -v out '%q' "$arg"
    else
      local quoted
      printf -v quoted '%q' "$arg"
      out="$out $quoted"
    fi
  done
  printf '%s\n' "$out"
}

script_path() {
  local source_path="$0"
  if command -v readlink >/dev/null 2>&1; then
    source_path=$(readlink -f "$0" 2>/dev/null || printf '%s\n' "$0")
  fi
  if [ "$source_path" = "$0" ]; then
    printf '%s/%s\n' "$(cd "$(dirname "$0")" && pwd -P)" "$(basename "$0")"
  else
    printf '%s\n' "$source_path"
  fi
}

byobu_tmux_cmd() {
  if [ -n "${TMUX_TMPDIR:-}" ]; then
    printf '%s\n' "tmux"
    return 0
  fi

  if command -v byobu-tmux >/dev/null 2>&1; then
    printf '%s\n' "byobu-tmux"
  else
    printf '%s\n' "tmux"
  fi
}

codex_cmd() {
  if [ -n "${BYOBU_CODEX_BIN:-}" ]; then
    printf '%s\n' "$BYOBU_CODEX_BIN"
    return 0
  fi

  local codex_path package_bin package_root native
  codex_path=$(command -v codex 2>/dev/null || true)
  if [ -n "$codex_path" ] && command -v readlink >/dev/null 2>&1; then
    package_bin=$(readlink -f "$codex_path" 2>/dev/null || true)
    case "$package_bin" in
      */@openai/codex/bin/codex.js)
        package_root=${package_bin%/bin/codex.js}
        for native in "$package_root"/node_modules/@openai/codex-linux-*/vendor/*/bin/codex; do
          if [ -x "$native" ]; then
            printf '%s\n' "$native"
            return 0
          fi
        done
        ;;
    esac
  fi

  printf '%s\n' "${codex_path:-codex}"
}

codex_permission_args() {
  printf '%s\n' --sandbox danger-full-access --ask-for-approval never
}

source_byobu_profile() {
  [ -z "${TMUX_TMPDIR:-}" ] || return 0
  command -v byobu-tmux >/dev/null 2>&1 || return 0
  local profile
  for profile in /usr/share/byobu/profiles/tmux /usr/share/byobu/profiles/tmuxrc; do
    [ -r "$profile" ] || continue
    byobu-tmux source-file "$profile" >/dev/null 2>&1 || true
  done
}

state_cmd() {
  local script_dir
  script_dir=$(cd "$(dirname "$0")" && pwd -P)

  if [ -x "$script_dir/byobu-session-state" ]; then
    "$script_dir/byobu-session-state" "$@"
  elif command -v byobu-session-state >/dev/null 2>&1; then
    byobu-session-state "$@"
  else
    "$HOME/.local/bin/byobu-session-state" "$@"
  fi
}

latest_session_name() {
  tmux list-sessions -F '#{session_attached} #{session_activity} #{session_id} #{session_name}' 2>/dev/null \
    | awk '{ gsub(/[^0-9]/, "", $3); print }' \
    | sort -k1,1nr -k2,2nr -k3,3nr \
    | sed -n '1s/^[^ ]* [^ ]* [^ ]* //p'
}

current_session_name() {
  tmux display-message -p '#S'
}

current_window_id() {
  [ -n "${TMUX_PANE:-}" ] || return 1
  tmux display-message -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null
}

safe_cwd() {
  local cwd="${1:-$PWD}"
  [ -d "$cwd" ] || fail "directory not found: $cwd"
  (cd "$cwd" && pwd -P)
}

set_window_option() {
  local target="$1"
  local key="$2"
  local value="$3"
  [ -n "$target" ] || return 0
  tmux set-option -wq -t "$target" "$key" "$value" >/dev/null 2>&1 || true
}

window_option() {
  local target="$1"
  local key="$2"
  tmux show-options -wqv -t "$target" "$key" 2>/dev/null || true
}

set_codex_window_options() {
  local target="$1"
  local mode="$2"
  local cwd="$3"
  local thread_id="${4:-}"
  local started_at_ms="${5:-}"

  set_window_option "$target" "@byobu-codex" "1"
  set_window_option "$target" "@byobu-codex-mode" "$mode"
  set_window_option "$target" "@byobu-codex-cwd" "$cwd"
  set_window_option "$target" "@byobu-codex-resume" "1"
  [ -z "$started_at_ms" ] || set_window_option "$target" "@byobu-codex-started-at-ms" "$started_at_ms"
  if is_uuid_like "$thread_id"; then
    set_window_option "$target" "@byobu-codex-thread-id" "$thread_id"
  fi
}

codex_home() {
  printf '%s\n' "${CODEX_HOME:-$HOME/.codex}"
}

codex_state_db() {
  printf '%s/state_5.sqlite\n' "$(codex_home)"
}

recent_thread_for_cwd_since() {
  local cwd="$1"
  local started_at_ms="${2:-0}"
  local db
  db=$(codex_state_db)
  [ -f "$db" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0

  python3 - "$db" "$cwd" "$started_at_ms" "${@:3}" <<'PY'
import sqlite3
import sys

db, cwd, started = sys.argv[1], sys.argv[2], sys.argv[3]
excluded = set(sys.argv[4:])
try:
    threshold = max(0, int(started) - 5000)
except ValueError:
    threshold = 0

try:
    conn = sqlite3.connect(db)
    rows = conn.execute(
        """
        select id, created_at, updated_at, recency_at, created_at_ms, updated_at_ms, recency_at_ms
        from threads
        where archived = 0 and cwd = ?
        order by coalesce(recency_at_ms, recency_at * 1000, updated_at_ms, updated_at * 1000, created_at_ms, created_at * 1000) desc
        limit 20
        """,
        (cwd,),
    ).fetchall()
except Exception:
    sys.exit(0)

for row in rows:
    thread_id = row[0]
    if thread_id in excluded:
        continue
    times = []
    for value in row[1:4]:
        if value is not None:
            times.append(int(value) * 1000)
    for value in row[4:7]:
        if value is not None:
            times.append(int(value))
    if times and max(times) >= threshold:
        print(thread_id)
        break
PY
}

infer_thread_for_window() {
  local window_name="$1"
  local cwd="$2"
  local db
  db=$(codex_state_db)
  [ -f "$db" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0

  python3 - "$db" "$cwd" "$window_name" <<'PY'
import re
import sqlite3
import sys

db, cwd, window_name = sys.argv[1], sys.argv[2], sys.argv[3]
tokens = set(re.findall(r"[a-z0-9]{4,}", window_name.lower()))
if not tokens:
    sys.exit(0)

try:
    conn = sqlite3.connect(db)
    rows = conn.execute(
        """
        select id, coalesce(title, ''), coalesce(preview, ''), coalesce(first_user_message, ''),
               coalesce(recency_at_ms, recency_at * 1000, updated_at_ms, updated_at * 1000, created_at_ms, created_at * 1000, 0) as rank_time
        from threads
        where archived = 0 and cwd = ?
        order by rank_time desc
        limit 50
        """,
        (cwd,),
    ).fetchall()
except Exception:
    sys.exit(0)

best = None
for recency_rank, row in enumerate(rows):
    thread_id, title, preview, first_message, _ = row
    text = f"{title}\n{preview}\n{first_message}".lower()
    score = sum(1 for token in tokens if token in text)
    if window_name.lower() in text:
        score += 3
    if score <= 0:
        continue
    candidate = (score, -recency_rank, thread_id)
    if best is None or candidate > best:
        best = candidate

if best is not None:
    print(best[2])
PY
}

monitor_new_thread() {
  local window_target="$1"
  local cwd="$2"
  local started_at_ms="$3"
  local timeout="${BYOBU_CODEX_MONITOR_SECONDS:-604800}"
  local deadline=$((SECONDS + timeout))
  local thread_id

  while [ "$SECONDS" -lt "$deadline" ]; do
    thread_id=$(recent_thread_for_cwd_since "$cwd" "$started_at_ms" || true)
    if is_uuid_like "$thread_id"; then
      set_window_option "$window_target" "@byobu-codex-thread-id" "$thread_id"
      set_window_option "$window_target" "@byobu-codex-mode" "resume"
      state_cmd autosave "$snapshot_name" >/dev/null 2>&1 || true
      return 0
    fi
    sleep 5
  done
}

process_tree_contains_codex() {
  local root_pid="$1"
  command -v python3 >/dev/null 2>&1 || return 1

  python3 - "$root_pid" <<'PY'
import subprocess
import sys
from collections import defaultdict, deque

try:
    root = int(sys.argv[1])
except ValueError:
    sys.exit(1)

try:
    output = subprocess.check_output(["ps", "-eo", "pid=,ppid=,args="], text=True)
except Exception:
    sys.exit(1)

children = defaultdict(list)
args_by_pid = {}
for line in output.splitlines():
    parts = line.strip().split(None, 2)
    if len(parts) < 3:
        continue
    try:
        pid = int(parts[0])
        ppid = int(parts[1])
    except ValueError:
        continue
    args = parts[2]
    children[ppid].append(pid)
    args_by_pid[pid] = args

queue = deque([root])
seen = set()
while queue:
    pid = queue.popleft()
    if pid in seen:
        continue
    seen.add(pid)
    args = args_by_pid.get(pid, "")
    lowered = args.lower()
    if "codex" in lowered and ("@openai/codex" in lowered or "/codex" in lowered or " codex" in lowered):
        sys.exit(0)
    queue.extend(children.get(pid, []))

sys.exit(1)
PY
}

codex_descendant_started_at_ms() {
  local root_pid="$1"
  command -v python3 >/dev/null 2>&1 || return 1

  python3 - "$root_pid" <<'PY'
import os
import subprocess
import sys
import time
from collections import defaultdict, deque

try:
    root = int(sys.argv[1])
except ValueError:
    sys.exit(1)

try:
    output = subprocess.check_output(["ps", "-eo", "pid=,ppid=,args="], text=True)
except Exception:
    sys.exit(1)

children = defaultdict(list)
args_by_pid = {}
for line in output.splitlines():
    parts = line.strip().split(None, 2)
    if len(parts) < 3:
        continue
    try:
        pid = int(parts[0])
        ppid = int(parts[1])
    except ValueError:
        continue
    args = parts[2]
    children[ppid].append(pid)
    args_by_pid[pid] = args

try:
    with open("/proc/uptime", "r", encoding="utf-8") as fh:
        uptime = float(fh.read().split()[0])
    ticks_per_second = os.sysconf(os.sysconf_names["SC_CLK_TCK"])
except Exception:
    sys.exit(1)

boot_time = time.time() - uptime
started_values = []
queue = deque([root])
seen = set()
while queue:
    pid = queue.popleft()
    if pid in seen:
        continue
    seen.add(pid)
    args = args_by_pid.get(pid, "")
    lowered = args.lower()
    if "codex" in lowered and ("@openai/codex" in lowered or "/codex" in lowered or " codex" in lowered):
        try:
            stat = open(f"/proc/{pid}/stat", "r", encoding="utf-8").read()
            after_comm = stat.rsplit(") ", 1)[1].split()
            start_ticks = int(after_comm[19])
            started_values.append(int((boot_time + start_ticks / ticks_per_second) * 1000))
        except Exception:
            pass
    queue.extend(children.get(pid, []))

if not started_values:
    sys.exit(1)

print(min(started_values))
PY
}

codex_descendant_thread_id() {
  local root_pid="$1"
  command -v python3 >/dev/null 2>&1 || return 1

  python3 - "$root_pid" <<'PY'
import os
import subprocess
import sys
from collections import defaultdict, deque

try:
    root = int(sys.argv[1])
except ValueError:
    sys.exit(1)

try:
    output = subprocess.check_output(["ps", "-eo", "pid=,ppid=,args="], text=True)
except Exception:
    sys.exit(1)

children = defaultdict(list)
args_by_pid = {}
for line in output.splitlines():
    parts = line.strip().split(None, 2)
    if len(parts) < 3:
        continue
    try:
        pid = int(parts[0])
        ppid = int(parts[1])
    except ValueError:
        continue
    children[ppid].append(pid)
    args_by_pid[pid] = parts[2]

queue = deque([root])
seen = set()
while queue:
    pid = queue.popleft()
    if pid in seen:
        continue
    seen.add(pid)
    args = args_by_pid.get(pid, "")
    lowered = args.lower()
    looks_like_codex = "codex" in lowered and ("@openai/codex" in lowered or "/codex" in lowered or " codex" in lowered)
    if looks_like_codex:
        try:
            env = open(f"/proc/{pid}/environ", "rb").read().split(b"\0")
        except Exception:
            env = []
        for item in env:
            if item.startswith(b"CODEX_THREAD_ID="):
                value = item.split(b"=", 1)[1].decode("utf-8", "ignore")
                if value:
                    print(value)
                    sys.exit(0)
    queue.extend(children.get(pid, []))

sys.exit(1)
PY
}

default_tab_name() {
  local first_arg="${1:-Codex}"
  first_arg=$(printf '%s' "$first_arg" | tr '\n\t' '  ' | sed 's/^ *//; s/ *$//')
  [ -n "$first_arg" ] || first_arg="Codex"
  printf '%.48s\n' "$first_arg"
}

cmd_add() {
  ensure_tmux

  local name=""
  local session=""
  local cwd="$PWD"
  local select_window=1
  local thread_id=""
  local -a codex_args=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -n|--name)
        [ "$#" -ge 2 ] || fail_usage "$1 requires a value"
        name="$2"
        shift 2
        ;;
      -s|--session)
        [ "$#" -ge 2 ] || fail_usage "$1 requires a value"
        session="$2"
        shift 2
        ;;
      -C|--cd)
        [ "$#" -ge 2 ] || fail_usage "$1 requires a value"
        cwd="$2"
        shift 2
        ;;
      --thread|--resume)
        [ "$#" -ge 2 ] || fail_usage "$1 requires a value"
        thread_id="$2"
        shift 2
        ;;
      --no-select)
        select_window=0
        shift
        ;;
      --)
        shift
        while [ "$#" -gt 0 ]; do
          codex_args+=("$1")
          shift
        done
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        codex_args+=("$1")
        shift
        ;;
    esac
  done

  if [ -n "$thread_id" ] && ! is_uuid_like "$thread_id"; then
    fail "Codex session id must be a UUID: $thread_id"
  fi

  cwd=$(safe_cwd "$cwd")
  if [ -z "$name" ]; then
    if [ -n "$thread_id" ]; then
      name="Codex ${thread_id:0:8}"
    else
      name=$(default_tab_name "${codex_args[0]:-Codex}")
    fi
  fi

  if [ -z "$session" ]; then
    if [ -n "${TMUX:-}" ]; then
      session=$(current_session_name)
    else
      session=$(latest_session_name || true)
      [ -n "$session" ] || session="$default_session"
    fi
  fi

  local create_session=0
  if ! tmux has-session -t "$session" 2>/dev/null; then
    create_session=1
  fi

  local started_at_ms
  started_at_ms=$(now_ms)

  local wrapper
  wrapper=$(script_path)

  local -a run_args=()
  if [ -n "$thread_id" ]; then
    run_args+=(env "CODEX_THREAD_ID=$thread_id")
  else
    run_args+=(env -u CODEX_THREAD_ID)
  fi
  run_args+=("$wrapper" run --cwd "$cwd" --window-name "$name" --started-at-ms "$started_at_ms")
  if [ -n "$thread_id" ]; then
    run_args+=(--thread "$thread_id")
  fi
  run_args+=(--)
  run_args+=("${codex_args[@]}")

  local shell_cmd
  shell_cmd=$(shell_join "${run_args[@]}")

  local window_id launcher
  if [ "$create_session" -eq 1 ]; then
    launcher=$(byobu_tmux_cmd)
    window_id=$("$launcher" new-session -d -P -F '#{window_id}' -s "$session" -n "$name" -c "$cwd" "$shell_cmd")
    source_byobu_profile
  else
    window_id=$(tmux new-window -d -P -F '#{window_id}' -t "$session:" -n "$name" -c "$cwd" "$shell_cmd")
  fi

  if [ -n "$window_id" ]; then
    if [ -n "$thread_id" ]; then
      set_codex_window_options "$window_id" "resume" "$cwd" "$thread_id" "$started_at_ms"
    else
      set_codex_window_options "$window_id" "new" "$cwd" "" "$started_at_ms"
    fi
  fi

  if [ "$select_window" -eq 1 ] && tmux has-session -t "$session" 2>/dev/null; then
    tmux select-window -t "$window_id" >/dev/null 2>&1 || true
  fi

  state_cmd autosave "$snapshot_name" "$session" >/dev/null 2>&1 || true

  if [ -n "$thread_id" ]; then
    printf 'Added Byobu Codex tab %s in session %s for %s\n' "$name" "$session" "$thread_id"
  else
    printf 'Added Byobu Codex tab %s in session %s\n' "$name" "$session"
  fi
}

cmd_resume() {
  local -a prefix_args=()
  local thread_id=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -n|--name|-s|--session|-C|--cd)
        [ "$#" -ge 2 ] || fail_usage "$1 requires a value"
        prefix_args+=("$1" "$2")
        shift 2
        ;;
      --no-select)
        prefix_args+=("$1")
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      --)
        shift
        break
        ;;
      -*)
        fail_usage "unknown resume option before SESSION_ID: $1"
        ;;
      *)
        thread_id="$1"
        shift
        break
        ;;
    esac
  done

  [ -n "$thread_id" ] || fail_usage "resume requires a Codex session id"
  cmd_add "${prefix_args[@]}" --thread "$thread_id" -- "$@"
}

cmd_run() {
  local cwd="$PWD"
  local window_name=""
  local started_at_ms=""
  local thread_id=""
  local window_target=""
  local -a codex_args=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --cwd)
        [ "$#" -ge 2 ] || fail_usage "$1 requires a value"
        cwd="$2"
        shift 2
        ;;
      --window-name)
        [ "$#" -ge 2 ] || fail_usage "$1 requires a value"
        window_name="$2"
        shift 2
        ;;
      --started-at-ms)
        [ "$#" -ge 2 ] || fail_usage "$1 requires a value"
        started_at_ms="$2"
        shift 2
        ;;
      --thread)
        [ "$#" -ge 2 ] || fail_usage "$1 requires a value"
        thread_id="$2"
        shift 2
        ;;
      --window-target|--window-id)
        [ "$#" -ge 2 ] || fail_usage "$1 requires a value"
        window_target="$2"
        shift 2
        ;;
      --)
        shift
        while [ "$#" -gt 0 ]; do
          codex_args+=("$1")
          shift
        done
        ;;
      *)
        codex_args+=("$1")
        shift
        ;;
    esac
  done

  cwd=$(safe_cwd "$cwd")
  cd "$cwd"
  [ -n "$started_at_ms" ] || started_at_ms=$(now_ms)
  [ -n "$window_target" ] || window_target=$(current_window_id || true)
  if is_uuid_like "$thread_id"; then
    export CODEX_THREAD_ID="$thread_id"
  else
    unset CODEX_THREAD_ID
  fi

  if [ -n "$window_target" ]; then
    if [ -n "$window_name" ]; then
      tmux rename-window -t "$window_target" "$window_name" >/dev/null 2>&1 || true
    fi
    if is_uuid_like "$thread_id"; then
      set_codex_window_options "$window_target" "resume" "$cwd" "$thread_id" "$started_at_ms"
    else
      set_codex_window_options "$window_target" "new" "$cwd" "" "$started_at_ms"
    fi
  fi

  local monitor_started=0
  local status=0
  local restart_delay="${BYOBU_CODEX_RESTART_DELAY:-3}"
  local codex_bin
  codex_bin=$(codex_cmd)
  local -a permission_args=()
  mapfile -t permission_args < <(codex_permission_args)

  while true; do
    if ! is_uuid_like "$thread_id" && [ "$monitor_started" -eq 0 ] && [ -n "$window_target" ]; then
      monitor_new_thread "$window_target" "$cwd" "$started_at_ms" >/dev/null 2>&1 &
      monitor_started=1
    fi

    set +e
    if is_uuid_like "$thread_id"; then
      CODEX_THREAD_ID="$thread_id" "$codex_bin" "${permission_args[@]}" resume "$thread_id" "${codex_args[@]}"
    else
      env -u CODEX_THREAD_ID "$codex_bin" "${permission_args[@]}" "${codex_args[@]}"
    fi
    status=$?
    set -e

    if ! is_uuid_like "$thread_id" && [ -n "$window_target" ]; then
      thread_id=$(window_option "$window_target" "@byobu-codex-thread-id")
    fi
    if ! is_uuid_like "$thread_id"; then
      thread_id=$(recent_thread_for_cwd_since "$cwd" "$started_at_ms" || true)
      if is_uuid_like "$thread_id" && [ -n "$window_target" ]; then
        set_codex_window_options "$window_target" "resume" "$cwd" "$thread_id" "$started_at_ms"
      fi
    fi

    if [ "$status" -ne 0 ] && truthy "${BYOBU_CODEX_AUTO_RESTART:-1}" && is_uuid_like "$thread_id"; then
      printf 'Codex exited with status %s; restarting %s in %s seconds.\n' "$status" "$thread_id" "$restart_delay" >&2
      sleep "$restart_delay"
      continue
    fi

    if truthy "${BYOBU_CODEX_KEEP_SHELL_ON_EXIT:-0}"; then
      printf 'Codex exited with status %s; leaving this Byobu tab open as a shell.\n' "$status" >&2
      exec "${SHELL:-/bin/bash}" -l
    fi

    printf 'Codex exited with status %s; closing this Byobu tab.\n' "$status" >&2
    exit "$status"
  done
}

cmd_adopt() {
  ensure_tmux

  local session_filter=""
  local dry_run=0
  local quiet=0
  local no_autosave=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -s|--session)
        [ "$#" -ge 2 ] || fail_usage "$1 requires a value"
        session_filter="$2"
        shift 2
        ;;
      --dry-run)
        dry_run=1
        shift
        ;;
      --quiet)
        quiet=1
        shift
        ;;
      --no-autosave)
        no_autosave=1
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        fail_usage "unknown adopt option: $1"
        ;;
    esac
  done

  local -A seen=()
  local -A used_threads=()
  local adopted=0
  local unresolved=0
  local session window_index window_name pane_index pane_pid pane_path pane_cmd key target existing thread_id env_thread_id

  while IFS= read -r existing; do
    if is_uuid_like "$existing"; then
      used_threads["$existing"]=1
    fi
  done < <(tmux list-windows -a -F '#{@byobu-codex-thread-id}' 2>/dev/null || true)

  while IFS=$'\t' read -r session window_index window_name pane_index pane_pid pane_path pane_cmd; do
    [ -n "$session" ] || continue
    if [ -n "$session_filter" ] && [ "$session" != "$session_filter" ]; then
      continue
    fi

    key="${session}:${window_index}"
    if [ -n "${seen[$key]:-}" ]; then
      continue
    fi

    if ! process_tree_contains_codex "$pane_pid"; then
      continue
    fi
    seen[$key]=1

    target="${session}:${window_index}"
    existing=$(window_option "$target" "@byobu-codex-thread-id")
    env_thread_id=$(codex_descendant_thread_id "$pane_pid" || true)
    if is_uuid_like "$existing"; then
      if is_uuid_like "$env_thread_id" && [ "$env_thread_id" != "$existing" ]; then
        used_threads["$env_thread_id"]=1
        if [ "$dry_run" -eq 1 ]; then
          printf 'Would correct %s %s -> %s\n' "$target" "$window_name" "$env_thread_id"
        else
          set_codex_window_options "$target" "resume" "$pane_path" "$env_thread_id" "$(now_ms)"
          adopted=$((adopted + 1))
          [ "$quiet" -eq 1 ] || printf 'Corrected %s %s -> %s\n' "$target" "$window_name" "$env_thread_id"
        fi
        continue
      fi
      [ "$quiet" -eq 1 ] || printf 'Already adopted %s %s -> %s\n' "$target" "$window_name" "$existing"
      continue
    fi

    thread_id="$env_thread_id"
    if ! is_uuid_like "$thread_id"; then
      thread_id=$(infer_thread_for_window "$window_name" "$pane_path" || true)
    fi
    if ! is_uuid_like "$thread_id"; then
      local codex_started_at_ms
      codex_started_at_ms=$(codex_descendant_started_at_ms "$pane_pid" || true)
      if [ -n "$codex_started_at_ms" ]; then
        thread_id=$(recent_thread_for_cwd_since "$pane_path" "$codex_started_at_ms" "${!used_threads[@]}" || true)
      fi
    fi
    if ! is_uuid_like "$thread_id"; then
      unresolved=$((unresolved + 1))
      [ "$quiet" -eq 1 ] || printf 'Could not infer Codex session for %s %s\n' "$target" "$window_name" >&2
      continue
    fi

    used_threads["$thread_id"]=1
    if [ "$dry_run" -eq 1 ]; then
      printf 'Would adopt %s %s -> %s\n' "$target" "$window_name" "$thread_id"
    else
      set_codex_window_options "$target" "resume" "$pane_path" "$thread_id" "$(now_ms)"
      adopted=$((adopted + 1))
      [ "$quiet" -eq 1 ] || printf 'Adopted %s %s -> %s\n' "$target" "$window_name" "$thread_id"
    fi
  done < <(tmux list-panes -a -F '#{session_name}	#{window_index}	#{window_name}	#{pane_index}	#{pane_pid}	#{pane_current_path}	#{pane_current_command}' 2>/dev/null || true)

  if [ "$dry_run" -eq 0 ] && [ "$adopted" -gt 0 ] && [ "$no_autosave" -eq 0 ] && ! truthy "${BYOBU_CODEX_ADOPT_NO_AUTOSAVE:-0}"; then
    if [ -n "$session_filter" ]; then
      state_cmd autosave "$snapshot_name" "$session_filter" >/dev/null 2>&1 || true
    else
      state_cmd autosave "$snapshot_name" >/dev/null 2>&1 || true
    fi
  fi

  [ "$quiet" -eq 1 ] || printf 'Adopted: %s, unresolved: %s\n' "$adopted" "$unresolved"
}

cmd_list() {
  [ "$#" -eq 0 ] || fail_usage "list does not accept arguments"

  ensure_tmux
  printf 'Live Byobu Codex tabs:\n'
  tmux list-windows -a -F '#{session_name}	#{window_index}	#{window_name}	#{pane_current_path}	#{@byobu-codex-thread-id}' 2>/dev/null \
    | awk -F '\t' 'NF >= 5 && $5 != "" { printf "  %s:%s %s cwd=%s thread=%s\n", $1, $2, $3, $4, $5; found=1 } END { if (!found) print "  none tagged" }'

  local db
  db=$(codex_state_db)
  if [ -f "$db" ] && command -v sqlite3 >/dev/null 2>&1; then
    printf '\nRecent Codex threads:\n'
    sqlite3 -separator $'\t' "$db" \
      "select id, substr(coalesce(nullif(title,''), nullif(preview,''), first_user_message, ''), 1, 80), cwd from threads where archived=0 order by coalesce(recency_at_ms, recency_at * 1000, updated_at_ms, updated_at * 1000, created_at_ms, created_at * 1000) desc limit 10;" \
      | awk -F '\t' '{ printf "  %s %s cwd=%s\n", $1, $2, $3 }'
  fi
}

cmd_save() {
  [ "$#" -eq 0 ] || fail_usage "save does not accept arguments"
  state_cmd autosave "$snapshot_name"
}

cmd_restore() {
  [ "$#" -eq 0 ] || fail_usage "restore does not accept arguments"
  state_cmd autorestore --restart-codex "$snapshot_name"
}

cmd_attach() {
  [ "$#" -eq 0 ] || fail_usage "attach does not accept arguments"
  state_cmd autorestore --restart-codex "$snapshot_name" >/dev/null || true

  if command -v byobu >/dev/null 2>&1; then
    exec byobu
  fi

  local session
  session=$(latest_session_name || true)
  if [ -n "$session" ]; then
    exec tmux attach-session -t "$session"
  fi

  exec tmux new-session -s "$default_session"
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    add|new)
      shift
      cmd_add "$@"
      ;;
    resume)
      shift
      cmd_resume "$@"
      ;;
    run)
      shift
      cmd_run "$@"
      ;;
    adopt)
      shift
      cmd_adopt "$@"
      ;;
    list)
      shift
      cmd_list "$@"
      ;;
    save)
      shift
      cmd_save "$@"
      ;;
    restore)
      shift
      cmd_restore "$@"
      ;;
    attach)
      shift
      cmd_attach "$@"
      ;;
    --version|version)
      printf 'byobu-codex %s\n' "$version"
      ;;
    -h|--help|help|'')
      usage
      ;;
    *)
      fail_usage "Unknown subcommand: $cmd"
      ;;
  esac
}

main "$@"
