#!/usr/bin/env bash
set -euo pipefail

snapshot_name="${BYOBU_SESSION_AUTOSAVE_NAME:-autosave}"

truthy() {
  case "${1:-}" in
    1|true|TRUE|yes|YES|y|Y|on|ON)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

shell_join() {
  local out="" arg quoted
  for arg in "$@"; do
    if [ -z "$out" ]; then
      printf -v out '%q' "$arg"
    else
      printf -v quoted '%q' "$arg"
      out="$out $quoted"
    fi
  done
  printf '%s\n' "$out"
}

state_cmd_path() {
  local script_dir
  script_dir=$(cd "$(dirname "$0")" && pwd -P)

  if command -v byobu-session-state >/dev/null 2>&1; then
    command -v byobu-session-state
  elif [ -x "$script_dir/byobu-session-state" ]; then
    printf '%s\n' "$script_dir/byobu-session-state"
  else
    printf '%s\n' "$HOME/.local/bin/byobu-session-state"
  fi
}

state_cmd() {
  local cmd
  cmd=$(state_cmd_path)
  "$cmd" "$@"
}

real_byobu_bin() {
  if [ -n "${BYOBU_REAL_BIN:-}" ]; then
    printf '%s\n' "$BYOBU_REAL_BIN"
    return 0
  fi

  local candidate
  for candidate in /usr/bin/byobu /bin/byobu /usr/local/bin/byobu; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

byobu_tmux_cmd() {
  if command -v byobu-tmux >/dev/null 2>&1; then
    printf '%s\n' "byobu-tmux"
  else
    printf '%s\n' "tmux"
  fi
}

session_codex_thread_count() {
  local session="$1"
  tmux list-windows -t "$session" -F '#{@byobu-codex-thread-id}' 2>/dev/null \
    | awk 'NF { count++ } END { print count + 0 }'
}

tmux_has_sessions() {
  tmux list-sessions >/dev/null 2>&1
}

install_tmux_exit_autosave_hooks() {
  truthy "${BYOBU_SESSION_SKIP_EXIT_HOOKS:-0}" && return 0
  command -v tmux >/dev/null 2>&1 || return 0

  local state_path hook_cmd hook_body tmux_bin
  state_path=$(state_cmd_path) || return 0
  [ -x "$state_path" ] || return 0

  local -a cmd=(env BYOBU_SESSION_SKIP_CODEX_ADOPT=1)
  if [ -n "${TMUX_TMPDIR:-}" ]; then
    cmd+=(TMUX_TMPDIR="$TMUX_TMPDIR")
  fi
  if [ -n "${BYOBU_SESSION_STATE_DIR:-}" ]; then
    cmd+=(BYOBU_SESSION_STATE_DIR="$BYOBU_SESSION_STATE_DIR")
  fi
  cmd+=("$state_path" hook-autosave "$snapshot_name")

  hook_cmd=$(shell_join "${cmd[@]}")
  hook_body="run-shell -b \"$hook_cmd >/dev/null 2>&1 || true\""
  tmux_bin=$(byobu_tmux_cmd)

  "$tmux_bin" set-hook -g 'window-unlinked[90]' "$hook_body" >/dev/null 2>&1 || true
  "$tmux_bin" set-hook -g 'session-closed[90]' "$hook_body" >/dev/null 2>&1 || true
}

best_live_session_name() {
  command -v tmux >/dev/null 2>&1 || return 1

  local session windows attached activity codex
  {
    while IFS=$'\t' read -r session windows attached activity; do
      [ -n "$session" ] || continue
      codex=$(session_codex_thread_count "$session")
      printf '%s\t%s\t%s\t%s\t%s\n' "$windows" "$codex" "$attached" "$activity" "$session"
    done < <(tmux list-sessions -F '#{session_name}	#{session_windows}	#{session_attached}	#{session_activity}' 2>/dev/null || true)
  } | sort -t $'\t' -k1,1nr -k2,2nr -k3,3nr -k4,4nr | awk -F '\t' 'NR == 1 { print $5 }'
}

attach_best_session_if_plain_launch() {
  [ "$#" -eq 0 ] || return 1
  [ -z "${TMUX:-}" ] || return 1
  if ! truthy "${BYOBU_SESSION_FORCE_ATTACH:-0}"; then
    [ -t 0 ] && [ -t 1 ] || return 1
  fi

  local session tmux_bin
  session=$(best_live_session_name || true)
  if [ -z "$session" ]; then
    local new_session="${BYOBU_SESSION_DEFAULT_NAME:-byobu}"
    tmux_bin=$(byobu_tmux_cmd)
    "$tmux_bin" new-session -d -s "$new_session" >/dev/null 2>&1 || return 1
    install_tmux_exit_autosave_hooks
    session="$new_session"
  fi
  [ -n "$session" ] || return 1

  tmux_bin=$(byobu_tmux_cmd)
  exec "$tmux_bin" attach-session -t "$session"
}

if ! truthy "${BYOBU_SESSION_SKIP_AUTORESTORE:-0}"; then
  state_cmd autorestore --restart-codex "$snapshot_name" >/dev/null || true
fi

install_tmux_exit_autosave_hooks

if attach_best_session_if_plain_launch "$@"; then
  exit 0
fi

real_byobu=$(real_byobu_bin) || {
  printf 'real byobu binary not found. Set BYOBU_REAL_BIN to its path.\n' >&2
  exit 127
}

exec "$real_byobu" "$@"
